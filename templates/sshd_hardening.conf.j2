# {{ ansible_managed }}
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
MaxAuthTries 3
AllowUsers {{ ansible_user }}

# Lynis SSH-7408. Ansible needs none of the forwarding features, and opens one
# session at a time. Port stays 22: moving it hides SSH without securing it.
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
MaxSessions 2
LogLevel VERBOSE

# Drop dead connections after 10 minutes, checked inside the encrypted channel
# rather than with spoofable TCP keepalives.
ClientAliveInterval 300
ClientAliveCountMax 2
TCPKeepAlive no
